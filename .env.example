# Copy to .env before `docker compose up`. Every value below has a working
# development default in code; .env is what makes the stack reproducible.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=True
# Hostnames Django will answer to. Reaching the app by anything other than
# localhost — a machine name, a LAN IP — returns 400 DisallowedHost until you
# add it here. Set to * if you do not care which host is used.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# Origins allowed to call the API cross-origin. Only needed for `npm run dev`
# on the host; the container stack is single-origin behind nginx.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Uploaded media -------------------------------------------------------
# Uploads are not public (A-1). Every file URL the API renders carries a signed
# token; the backend checks it and hands the bytes back to nginx through an
# internal location. How long a rendered link stays good, in seconds:
DJANGO_MEDIA_URL_TTL=604800

# Turn this off only when there is no nginx to honour `X-Accel-Redirect` — a
# bare `manage.py runserver` behind `npm run dev`. Django then streams the file
# itself, which is fine for development and wrong for anything else.
DJANGO_MEDIA_INTERNAL_REDIRECT=True

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=discord
POSTGRES_USER=discord
POSTGRES_PASSWORD=discord
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Redis ----------------------------------------------------------------
# The WebSocket channel layer, and nothing else — no application data. Unset it
# and the backend falls back to an in-process layer, which delivers only to
# clients that share the sender's process (RT-01).
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ / Celery ----------------------------------------------------
# Development credentials for the internal RabbitMQ service. RabbitMQ is not
# published to the host; Celery reaches it by the compose service name.
RABBITMQ_DEFAULT_USER=discord
RABBITMQ_DEFAULT_PASS=discord
CELERY_BROKER_URL=amqp://discord:discord@rabbitmq:5672//

# --- Frontend -------------------------------------------------------------
# Baked into the SPA at build time. Leave relative so the app talks to
# whatever origin serves it.
VITE_API_BASE_URL=/api/

# The WebSocket gateway (F-07). Left blank the client derives it from the page
# it was served by — `wss://` under https, `ws://` otherwise — which is right
# for the container stack and for `npm run dev`, whose proxy forwards /ws too.
# Set it only when the SPA is served from a different origin than the backend.
VITE_WS_BASE_URL=

# --- Demo data ------------------------------------------------------------
# The backend seeds majid / amirm / arvin (password testpass123) on every
# start. Idempotent, so it costs nothing to leave on; set to false if you want
# the database to stay empty.
DJANGO_SEED_DATA=true

# --- Linux file ownership -------------------------------------------------
# ./backend is bind-mounted into the container, so on Linux the backend writes
# to your files as this uid. If `id -u` says something other than 1000, set
# both of these to your own and rebuild (`docker compose up --build`).
# Docker Desktop on Windows and macOS translates ownership at the mount, so
# there is nothing to change there.
APP_UID=1000
APP_GID=1000

# --- Ports ----------------------------------------------------------------
# The single published port: the whole product is reachable here.
NGINX_PORT=8080