# Copy to .env before `docker compose up`. Every value below has a working
# development default in code; .env is what makes the stack reproducible.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=dev-only-insecure-key-change-me
DJANGO_DEBUG=True
# Hostnames Django will answer to. Reaching the app by anything other than
# localhost — a machine name, a LAN IP — returns 400 DisallowedHost until you
# add it here. Set to * if you do not care which host is used.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend,nginx

# Origins allowed to call the API cross-origin. Only needed for `npm run dev`
# on the host; the container stack is single-origin behind nginx.
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_DB=discord
POSTGRES_USER=discord
POSTGRES_PASSWORD=discord
POSTGRES_HOST=db
POSTGRES_PORT=5432

# --- Frontend -------------------------------------------------------------
# Baked into the SPA at build time. Leave relative so the app talks to
# whatever origin serves it.
VITE_API_BASE_URL=/api/

# --- Ports ----------------------------------------------------------------
# The single published port: the whole product is reachable here.
NGINX_PORT=8080
